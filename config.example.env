# Copy to config.local.env and fill local secrets.

# Optional comma-separated token pool. When set, this takes priority over APIFY_TOKEN.
APIFY_TOKENS=
APIFY_TOKEN=
APIFY_ACTOR_ID=
AMAZON_FACTORY_APIFY_REQUEST_RETRY_ATTEMPTS=3
AMAZON_MARKETPLACE=US

# Amazon Selling Partner API. Required only for live schema pulls,
# VALIDATION_PREVIEW, or real listing submission.
AMAZON_FACTORY_SP_API_MARKETPLACE=US
AMAZON_FACTORY_SP_API_MARKETPLACE_ID=ATVPDKIKX0DER
AMAZON_FACTORY_SP_API_SELLER_ID=
AMAZON_FACTORY_SP_API_LWA_CLIENT_ID=
AMAZON_FACTORY_SP_API_LWA_CLIENT_SECRET=
AMAZON_FACTORY_SP_API_REFRESH_TOKEN=
AMAZON_FACTORY_SP_API_ACCESS_TOKEN=

# Optional. Set this on Windows so jobs do not fall back to python.exe/py.exe launcher stubs.
AMAZON_FACTORY_PYTHON=

# Optional defaults used by template and publish stages.
DEFAULT_COUNTRY_OF_ORIGIN=
AMAZON_FACTORY_COPY_POLISH=true
AMAZON_FACTORY_COPY_TIMEOUT=30
AMAZON_FACTORY_COPY_TEMPERATURE=0.15
COPY_AI_ENABLED=true
# Listing copy uses the single configured OpenAI-compatible endpoint above.
# Local Amazon search-term database for DeepSeek/OpenAI-compatible copy planning.
# Import CSVs with: python scripts/factory.py ingest-search-terms <csv-or-dir>
AMAZON_FACTORY_SEARCH_TERMS_ENABLED=true
AMAZON_FACTORY_SEARCH_TERMS_DB=data/search_terms.sqlite
AMAZON_FACTORY_SEARCH_TERMS_LIMIT=6
# Refuse to write upload-ready templates when audit contains blocking errors.
AMAZON_FACTORY_TEMPLATE_BLOCK_ON_ERROR=true
# Refuse stale or unreachable generated image URLs before filling templates.
AMAZON_FACTORY_TEMPLATE_VALIDATE_IMAGE_URLS=true
AMAZON_FACTORY_TEMPLATE_URL_CHECK_TIMEOUT=8
# Mask-capable image edit provider keys.
KRILL_AI_API_KEY=
AICOST_API_KEY=
QC_YC_FIXED_API_KEY=
CXK_FIXED_API_KEY=
CAVOTI_API_KEY=

# Provider order, model, pixel size, and request semantics come only from
# configs/api_registry.json. Environment variables hold secrets and operations.
AMAZON_FACTORY_PROVIDER_TIMEOUT_SECONDS=90
AMAZON_FACTORY_R2_RETRY_ATTEMPTS=4

# Optional API Registry. Use this to add vision QA/diagnostic/GPT Image endpoints
# without editing code. Entries are auto-routed by explicit scope:
# - vision_qa -> optional HoldAI/Yunwu Gemini endpoints, not called by default QA-lite
# - vision_classification -> optional Namax/CCAPI gpt-5.5 diagnostic endpoint, not used by default classification
# - image_generation -> GPT Image provider pool
# Use api_type=openai_images_edit for OpenAI-compatible /images/edits gateways.
AMAZON_FACTORY_API_REGISTRY=
AMAZON_FACTORY_API_REGISTRY_FILE=

# Vision model keys. Role classification is deterministic by default.
# QA uses local QA-lite by default; vision endpoints are optional diagnostics.
HOLDAI_API_KEY=
YUNWU_API_KEY=
JIUGX_API_KEY=
NUWAFLUX_API_KEY=
NAMAX_API_KEY=
CCAPI_API_KEY=
CCSUB_API_KEY=
# Optional OpenAI-compatible Gemini router. Default registry URL is https://subrouter.ai/v1.
# Use https://www.subrouter.ai/v1 here when China direct routing is better.
SUBROUTER_BASE_URL=
QUQIAI_API_KEY=
ZIVV_API_KEY=
MODEL_PULS_API_KEY=
NEWTOKEN_API_KEY=
# Add model endpoints only in configs/api_registry.json. Environment variables
# are limited to secrets and timeouts, not provider routing or request semantics.
AMAZON_FACTORY_QA_WORKERS=4
# Child-level planning sends several images and a strict JSON contract. A short
# timeout creates duplicate backend requests whose late responses cannot be read.
# Deterministic OCR evidence layer for role classification and QA text checks.
# Missing or low-confidence OCR is inconclusive and blocks text-dependent roles.
PADDLEOCR_ENABLED=true
PADDLEOCR_API_TOKEN=
PADDLEOCR_API_URL=https://paddleocr.aistudio-app.com/api/v2/ocr/jobs
PADDLEOCR_MODEL=PP-OCRv5
PADDLEOCR_TIMEOUT=60
PADDLEOCR_POLL_INTERVAL=3
PADDLEOCR_RETRY_ATTEMPTS=3
PADDLEOCR_RETRY_BASE_DELAY=0.5
AMAZON_FACTORY_IMAGEGEN_PROVIDER_ATTEMPTS=2
AMAZON_FACTORY_IMAGEGEN_RETRY_DELAY_SECONDS=12
# Optional per-provider caps while keeping global imagegen workers > 1.
# AMAZON_FACTORY_PROVIDER_CONCURRENCY_KRILL_GPT_IMAGE_2=2
# AMAZON_FACTORY_PROVIDER_CONCURRENCY_CAVOTI_GPT_IMAGE_2=2

# Optional A+ stage. Required when running with --include-aplus.
AMAZON_APLUS_PAGE_ROOT=
AMAZON_FACTORY_APLUS_TIMEOUT_SECONDS=3600

# Cloudflare R2 publish stage. Required only when running with --upload.
R2_ENDPOINT=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_PUBLIC_BASE_URL=
R2_REGION=auto
