{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "job_state.schema.json",
  "title": "JobStateV8",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "job_id", "status", "stage", "stages", "tasks", "task_history", "artifacts", "errors", "invalidated_errors", "warnings", "updated_at"],
  "properties": {
    "schema_version": {"const": 8},
    "job_id": {"type": "string", "minLength": 1},
    "status": {"enum": ["pending", "running", "awaiting_review", "partial_success", "failed", "success"]},
    "status_reason": {"type": "string"},
    "generation_execution_scope": {
      "type": "object", "additionalProperties": false,
      "required": ["mode", "tasks", "selection_sha256"],
      "properties": {
        "mode": {"enum": ["all", "selected"]},
        "selection_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "tasks": {"oneOf": [
          {"type": "null"},
          {"type": "array", "minItems": 1, "items": {
            "type": "object", "additionalProperties": false,
            "required": ["child", "role", "task_fingerprint"],
            "properties": {
              "child": {"type": "string", "minLength": 1},
              "role": {"type": "string", "minLength": 1},
              "task_fingerprint": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
            }
          }}
        ]}
      },
      "allOf": [{"if": {"properties": {"mode": {"const": "all"}}},
        "then": {"properties": {"tasks": {"type": "null"}}},
        "else": {"properties": {"tasks": {"type": "array", "minItems": 1}}}}]
    },
    "stage": {"type": "string"},
    "stages": {"type": "object", "additionalProperties": {"type": "object"}},
    "tasks": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": ["logical_task_id", "owner_stage", "status", "input_revision_id", "attempts", "updated_at"],
        "properties": {
          "logical_task_id": {"type": "string", "minLength": 1},
          "owner_stage": {"type": "string", "minLength": 1},
          "status": {"enum": ["pending", "running", "retryable", "blocked", "review", "success"]},
          "input_revision_id": {"type": "string", "minLength": 64, "maxLength": 64},
          "attempt_id": {"type": "string"},
          "attempts": {"type": "integer", "minimum": 0},
          "error": {"type": "string"},
          "failure_owner": {"type": "string"},
          "reason_code": {"type": "string", "minLength": 1},
          "next_action": {"type": "string", "minLength": 1},
          "resume_condition": {"type": "string", "minLength": 1},
          "remote_request_allowed": {"type": "boolean"},
          "transport_attempt": {"type": "integer", "minimum": 0},
          "provider_attempts": {"type": "object", "additionalProperties": {"type": "integer", "minimum": 0}},
          "candidate_revision": {"type": "integer", "minimum": 0, "maximum": 99},
          "candidate_sha256": {"type": "string", "minLength": 64, "maxLength": 64},
          "execution_revision": {"type": "string", "minLength": 64, "maxLength": 64},
          "request_outcome": {"enum": ["unknown"]},
          "request_audit": {
            "type": "object",
            "required": ["request_id", "provider"],
            "properties": {
              "request_id": {"type": "string", "minLength": 1},
              "provider": {"type": "string", "minLength": 1}
            }
          },
          "updated_at": {"type": "string", "minLength": 1}
        }
      }
    },
    "task_history": {"type": "array", "items": {"type": "object"}},
    "artifacts": {
      "type": "object",
      "additionalProperties": {
        "oneOf": [
          {"type": "string"},
          {
            "type": "object",
            "required": ["kind", "path", "sha256"],
            "additionalProperties": false,
            "properties": {
              "kind": {"type": "string", "minLength": 1},
              "path": {"type": "string", "minLength": 1},
              "sha256": {"type": "string", "minLength": 64, "maxLength": 64}
            }
          }
        ]
      }
    },
    "errors": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["error_id", "stage", "logical_task_id", "input_revision_id", "message", "at"]
      }
    },
    "resolved_errors": {"type": "array", "items": {"type": "object"}},
    "invalidated_errors": {"type": "array", "items": {"type": "object"}},
    "warnings": {"type": "array", "items": {"type": "object"}},
    "updated_at": {"type": "string", "minLength": 1}
  }
}
